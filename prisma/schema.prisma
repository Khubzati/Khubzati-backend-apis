generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  directUrl    = env("DIRECT_URL")
  relationMode = "prisma"
}

model User {
  id                String         @id @default(uuid())
  username          String         @unique
  email             String         @unique
  password          String
  fullName          String?        @map("full_name")
  phoneNumber       String         @unique @map("phone_number")
  role              UserRole       @default(customer)
  isVerified        Boolean        @default(false) @map("is_verified")
  profilePictureUrl String?        @map("profile_picture_url")
  otp               String?
  otpExpiry         DateTime?      @map("otp_expiry")
  createdAt         DateTime       @default(now()) @map("created_at")
  createdBy         String?        @map("created_by")
  updatedAt         DateTime?      @updatedAt @map("updated_at")
  updatedBy         String?        @map("updated_by")
  deletedAt         DateTime?      @map("deleted_at")
  addresses         Address[]
  bakeries          Bakery[]
  restaurants       Restaurant[]
  reviews           Review[]
  orders            Order[]
  notifications     Notification[]
  carts             Cart[]
  favorites         Favorite[]
  driverProfile     DriverProfile?
  deviceTokens      DeviceToken[]
  refundRequests    RefundRequest[]      @relation("RefundRequester")
  approvedRefunds   RefundRequest[]      @relation("RefundApprover")
  disputeCases      DisputeCase[]        @relation("DisputeCustomer")
  disputeMessages   DisputeMessage[]
  resolvedDisputes  DisputeCase[]        @relation("DisputeResolver")
  payoutRequests    PayoutRequest[]      @relation("PayoutRequester")
  reviewedPayouts   PayoutRequest[]      @relation("PayoutReviewer")
  auditLogs         AuditLog[]
  recurringOrders   RecurringOrder[]

  @@map("users")
}

model Favorite {
  id         String             @id @default(uuid())
  userId     String             @map("user_id")
  targetType FavoriteTargetType @map("target_type")
  targetId   String             @map("target_id")
  createdAt  DateTime           @default(now()) @map("created_at")
  createdBy  String?            @map("created_by")
  updatedAt  DateTime?          @updatedAt @map("updated_at")
  updatedBy  String?            @map("updated_by")
  deletedAt  DateTime?          @map("deleted_at")
  user       User               @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([userId, targetType, targetId])
  @@index([userId, targetType])
  @@map("favorites")
}

model Address {
  id           String      @id @default(uuid())
  userId       String      @map("user_id")
  addressLine1 String      @map("address_line1")
  addressLine2 String?     @map("address_line2")
  city         String
  postalCode   String      @map("postal_code")
  country      String      @default("Saudi Arabia")
  addressType  AddressType @default(home) @map("address_type")
  isDefault    Boolean     @default(false) @map("is_default")
  latitude     Decimal?    @db.Decimal(10, 8)
  longitude    Decimal?    @db.Decimal(11, 8)
  createdAt    DateTime    @default(now()) @map("created_at")
  createdBy    String?     @map("created_by")
  updatedAt    DateTime?   @updatedAt @map("updated_at")
  updatedBy    String?     @map("updated_by")
  deletedAt    DateTime?   @map("deleted_at")
  user         User        @relation(fields: [userId], references: [id])
  orders       Order[]
  recurringOrders RecurringOrder[]

  @@map("addresses")
}

model Category {
  id               String       @id @default(uuid())
  name             String
  description      String?
  imageUrl         String?      @map("image_url")
  type             CategoryType @default(common)
  parentCategoryId String?      @map("parent_category_id")
  createdAt        DateTime     @default(now()) @map("created_at")
  createdBy        String?      @map("created_by")
  updatedAt        DateTime?    @updatedAt @map("updated_at")
  updatedBy        String?      @map("updated_by")
  deletedAt        DateTime?    @map("deleted_at")
  parentCategory   Category?    @relation("CategoryToSubcategory", fields: [parentCategoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subcategories    Category[]   @relation("CategoryToSubcategory")
  products         Product[]

  @@map("categories")
}

model BreadTypeCatalog {
  id          String    @id @default(uuid())
  key         String    @unique
  englishName String    @map("english_name")
  arabicName  String?   @map("arabic_name")
  imageUrl    String?   @map("image_url")
  imageSource String?   @map("image_source")
  imageCredit String?   @map("image_credit")
  description String?
  tags        Json?
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by")
  deletedAt   DateTime? @map("deleted_at")

  @@map("bread_type_catalog")
}

model Bakery {
  id                    String       @id @default(uuid())
  name                  String
  description           String?
  addressLine1          String       @map("address_line1")
  addressLine2          String?      @map("address_line2")
  city                  String
  postalCode            String       @map("postal_code")
  country               String       @default("Saudi Arabia")
  currency              String       @default("jod")
  phoneNumber           String       @map("phone_number")
  email                 String?
  logoUrl               String?      @map("logo_url")
  coverImageUrl         String?      @map("cover_image_url")
  commercialRegistryUrl String?      @map("commercial_registry_url")
  deliveryProvider      DeliveryProvider @default(third_party) @map("delivery_provider")
  operatingHours        Json?        @map("operating_hours")
  status                BakeryStatus @default(pending_approval)
  rejectionReason       String?      @map("rejection_reason")
  rejectedAt            DateTime?    @map("rejected_at")
  ownerId               String       @map("owner_id")
  averageRating         Float        @default(0) @map("average_rating")
  reviewCount           Int          @default(0) @map("review_count")
  createdAt             DateTime     @default(now()) @map("created_at")
  createdBy             String?      @map("created_by")
  updatedAt             DateTime?    @updatedAt @map("updated_at")
  updatedBy             String?      @map("updated_by")
  deletedAt             DateTime?    @map("deleted_at")
  owner                 User         @relation(fields: [ownerId], references: [id])
  products              Product[]
  reviews               Review[]
  orders                Order[]
  recurringOrders       RecurringOrder[]

  @@map("bakeries")
}

model Restaurant {
  id             String           @id @default(uuid())
  name           String
  description    String?
  cuisineType    String?          @map("cuisine_type")
  addressLine1   String           @map("address_line1")
  addressLine2   String?          @map("address_line2")
  city           String
  postalCode     String           @map("postal_code")
  country        String           @default("Saudi Arabia")
  currency       String           @default("jod")
  phoneNumber    String           @map("phone_number")
  email          String?
  logoUrl        String?          @map("logo_url")
  coverImageUrl  String?          @map("cover_image_url")
  operatingHours Json?            @map("operating_hours")
  status         RestaurantStatus @default(pending_approval)
  rejectionReason String?         @map("rejection_reason")
  rejectedAt      DateTime?       @map("rejected_at")
  ownerId        String           @map("owner_id")
  averageRating  Float            @default(0) @map("average_rating")
  reviewCount    Int              @default(0) @map("review_count")
  createdAt      DateTime         @default(now()) @map("created_at")
  createdBy      String?          @map("created_by")
  updatedAt      DateTime?        @updatedAt @map("updated_at")
  updatedBy      String?          @map("updated_by")
  deletedAt      DateTime?        @map("deleted_at")
  owner          User             @relation(fields: [ownerId], references: [id])
  products       Product[]
  reviews        Review[]
  orders         Order[]
  recurringOrders RecurringOrder[]

  @@map("restaurants")
}

model Product {
  id                     String      @id @default(uuid())
  name                   String
  description            String?
  price                  Decimal     @db.Decimal(10, 2)
  imageUrl               String?     @map("image_url")
  itemType               ItemType    @map("item_type")
  bakeryId               String?     @map("bakery_id")
  restaurantId           String?     @map("restaurant_id")
  categoryId             String?     @map("category_id")
  stockQuantity          Int         @default(0) @map("stock_quantity")
  preparationTimeMinutes Int?        @map("preparation_time_minutes")
  dietaryInfo            Json?       @map("dietary_info")
  isAvailable            Boolean     @default(true) @map("is_available")
  averageRating          Float       @default(0) @map("average_rating")
  reviewCount            Int         @default(0) @map("review_count")
  createdAt              DateTime    @default(now()) @map("created_at")
  createdBy              String?     @map("created_by")
  updatedAt              DateTime?   @updatedAt @map("updated_at")
  updatedBy              String?     @map("updated_by")
  deletedAt              DateTime?   @map("deleted_at")
  bakery                 Bakery?     @relation(fields: [bakeryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  restaurant             Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  category               Category?   @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviews                Review[]
  cartItems              CartItem[]
  orderItems             OrderItem[]

  @@map("products")
}

model Cart {
  id          String     @id @default(uuid())
  userId      String     @map("user_id")
  totalAmount Decimal    @default(0) @map("total_amount") @db.Decimal(10, 2)
  createdAt   DateTime   @default(now()) @map("created_at")
  createdBy   String?    @map("created_by")
  updatedAt   DateTime?  @updatedAt @map("updated_at")
  updatedBy   String?    @map("updated_by")
  deletedAt   DateTime?  @map("deleted_at")
  user        User       @relation(fields: [userId], references: [id])
  cartItems   CartItem[]

  @@map("carts")
}

model CartItem {
  id                  String    @id @default(uuid())
  cartId              String    @map("cart_id")
  productId           String    @map("product_id")
  quantity            Int       @default(1)
  price               Decimal   @db.Decimal(10, 2)
  subtotal            Decimal   @db.Decimal(10, 2)
  specialInstructions String?   @map("special_instructions")
  createdAt           DateTime  @default(now()) @map("created_at")
  createdBy           String?   @map("created_by")
  updatedAt           DateTime? @updatedAt @map("updated_at")
  updatedBy           String?   @map("updated_by")
  deletedAt           DateTime? @map("deleted_at")
  cart                Cart      @relation(fields: [cartId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product             Product   @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("cart_items")
}

model Order {
  id                    String           @id @default(uuid())
  userId                String           @map("user_id")
  bakeryId              String?          @map("bakery_id")
  restaurantId          String?          @map("restaurant_id")
  orderNumber           String           @unique @map("order_number")
  status                OrderStatus      @default(pending)
  orderType             OrderType        @map("order_type")
  deliveryAddressId     String?          @map("delivery_address_id")
  totalAmount           Decimal          @map("total_amount") @db.Decimal(10, 2)
  paymentMethod         PaymentMethod    @map("payment_method")
  paymentStatus         PaymentStatus    @default(pending) @map("payment_status")
  paymentProvider       PaymentProvider? @map("payment_provider")
  providerPaymentId     String?          @map("provider_payment_id")
  providerSessionId     String?          @map("provider_session_id")
  paymentAmount         Decimal?         @map("payment_amount") @db.Decimal(10, 2)
  currency              String           @default("JOD")
  paidAt                DateTime?        @map("paid_at")
  codCollectedAt        DateTime?        @map("cod_collected_at")
  codCollectedBy        String?          @map("cod_collected_by")
  paymentIntentId       String?          @map("payment_intent_id")
  paymentErrorMessage   String?          @map("payment_error_message")
  specialInstructions   String?          @map("special_instructions")
  estimatedDeliveryTime DateTime?        @map("estimated_delivery_time")
  actualDeliveryTime    DateTime?        @map("actual_delivery_time")
  createdAt             DateTime         @default(now()) @map("created_at")
  createdBy             String?          @map("created_by")
  updatedAt             DateTime?        @updatedAt @map("updated_at")
  updatedBy             String?          @map("updated_by")
  deletedAt             DateTime?        @map("deleted_at")
  user                  User             @relation(fields: [userId], references: [id])
  bakery                Bakery?          @relation(fields: [bakeryId], references: [id])
  restaurant            Restaurant?      @relation(fields: [restaurantId], references: [id])
  deliveryAddress       Address?         @relation(fields: [deliveryAddressId], references: [id])
  orderItems            OrderItem[]
  webhookEvents         WebhookEvent[]
  deliveryAssignment    DeliveryAssignment?
  financialRecord       OrderFinancialRecord?
  refundRequests        RefundRequest[]
  disputeCases          DisputeCase[]
  transactions          FinancialTransaction[]

  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@map("orders")
}

model DriverProfile {
  id           String               @id @default(uuid())
  userId       String               @unique @map("user_id")
  status       DriverStatus         @default(offline)
  vehicleType  String?              @map("vehicle_type")
  licensePlate String?              @map("license_plate")
  latitude     Decimal?             @db.Decimal(10, 8)
  longitude    Decimal?             @db.Decimal(11, 8)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime?            @updatedAt @map("updated_at")
  user         User                 @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignments  DeliveryAssignment[]

  @@map("driver_profiles")
}

model DeliveryAssignment {
  id          String         @id @default(uuid())
  orderId     String         @unique @map("order_id")
  driverId    String         @map("driver_id")
  status      String         @default("assigned")
  pickedUpAt  DateTime?      @map("picked_up_at")
  deliveredAt DateTime?      @map("delivered_at")
  rejectedAt  DateTime?      @map("rejected_at")
  failedAt    DateTime?      @map("failed_at")
  failureReason String?      @map("failure_reason")
  deliveryNote String?       @map("delivery_note")
  proofImageUrl String?      @map("proof_image_url")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime?      @updatedAt @map("updated_at")
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  driver      DriverProfile  @relation(fields: [driverId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([driverId])
  @@map("delivery_assignments")
}

model DeviceToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  platform  String?
  lastUsed  DateTime  @default(now()) @map("last_used")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId])
  @@map("device_tokens")
}

model WebhookEvent {
  id          String          @id @default(uuid())
  provider    PaymentProvider
  eventId     String          @map("event_id")
  eventType   String          @map("event_type")
  payload     Json
  orderId     String?         @map("order_id")
  processedAt DateTime        @default(now()) @map("processed_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  order       Order?          @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([provider, eventId])
  @@index([orderId])
  @@map("webhook_events")
}

model OrderItem {
  id                  String    @id @default(uuid())
  orderId             String    @map("order_id")
  productId           String    @map("product_id")
  quantity            Int       @default(1)
  price               Decimal   @db.Decimal(10, 2)
  subtotal            Decimal   @db.Decimal(10, 2)
  specialInstructions String?   @map("special_instructions")
  createdAt           DateTime  @default(now()) @map("created_at")
  createdBy           String?   @map("created_by")
  updatedAt           DateTime? @updatedAt @map("updated_at")
  updatedBy           String?   @map("updated_by")
  deletedAt           DateTime? @map("deleted_at")
  order               Order     @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product             Product   @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("order_items")
}

model Review {
  id           String      @id @default(uuid())
  userId       String      @map("user_id")
  rating       Int
  comment      String?
  reviewType   ReviewType  @map("review_type")
  productId    String?     @map("product_id")
  bakeryId     String?     @map("bakery_id")
  restaurantId String?     @map("restaurant_id")
  createdAt    DateTime    @default(now()) @map("created_at")
  createdBy    String?     @map("created_by")
  updatedAt    DateTime?   @updatedAt @map("updated_at")
  updatedBy    String?     @map("updated_by")
  deletedAt    DateTime?   @map("deleted_at")
  user         User        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product      Product?    @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bakery       Bakery?     @relation(fields: [bakeryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("reviews")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  title     String
  message   String
  type      NotificationType @default(system)
  isRead    Boolean          @default(false) @map("is_read")
  relatedId String?          @map("related_id")
  createdAt DateTime         @default(now()) @map("created_at")
  createdBy String?          @map("created_by")
  updatedAt DateTime?        @updatedAt @map("updated_at")
  updatedBy String?          @map("updated_by")
  deletedAt DateTime?        @map("deleted_at")
  user      User             @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model Todo {
  id        String   @id @default(uuid())
  title     String
  completed Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("todos")
}

model CommissionConfig {
  id         String           @id @default(uuid())
  scope      CommissionScope
  vendorType VendorType?      @map("vendor_type")
  vendorId   String?          @map("vendor_id")
  rateBps    Int              @map("rate_bps")
  isActive   Boolean          @default(true) @map("is_active")
  notes      String?
  createdAt  DateTime         @default(now()) @map("created_at")
  createdBy  String?          @map("created_by")
  updatedAt  DateTime?        @updatedAt @map("updated_at")
  updatedBy  String?          @map("updated_by")

  @@index([scope, isActive])
  @@index([vendorType, vendorId, isActive])
  @@map("commission_configs")
}

model OrderFinancialRecord {
  id                String    @id @default(uuid())
  orderId           String    @unique @map("order_id")
  grossAmount       Decimal   @map("gross_amount") @db.Decimal(10, 2)
  commissionRateBps Int       @map("commission_rate_bps")
  commissionAmount  Decimal   @map("commission_amount") @db.Decimal(10, 2)
  vendorNetAmount   Decimal   @map("vendor_net_amount") @db.Decimal(10, 2)
  refundedAmount    Decimal   @default(0) @map("refunded_amount") @db.Decimal(10, 2)
  payoutAmount      Decimal   @default(0) @map("payout_amount") @db.Decimal(10, 2)
  netPlatformAmount Decimal   @default(0) @map("net_platform_amount") @db.Decimal(10, 2)
  snapshot          Json?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime? @updatedAt @map("updated_at")
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([createdAt])
  @@map("order_financial_records")
}

model RefundRequest {
  id               String       @id @default(uuid())
  orderId          String       @map("order_id")
  requesterUserId  String       @map("requester_user_id")
  requesterRole    String       @map("requester_role")
  amount           Decimal      @db.Decimal(10, 2)
  reason           String
  status           RefundStatus @default(pending)
  adminNotes       String?      @map("admin_notes")
  providerRefundId String?      @map("provider_refund_id")
  approvedByUserId String?      @map("approved_by_user_id")
  approvedAt       DateTime?    @map("approved_at")
  processedAt      DateTime?    @map("processed_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime?    @updatedAt @map("updated_at")
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requester        User         @relation("RefundRequester", fields: [requesterUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approver         User?        @relation("RefundApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  transactions     FinancialTransaction[]

  @@index([orderId, status])
  @@index([requesterUserId, status])
  @@map("refund_requests")
}

model DisputeCase {
  id               String        @id @default(uuid())
  orderId          String        @map("order_id")
  customerId       String        @map("customer_id")
  vendorType       VendorType    @map("vendor_type")
  vendorId         String        @map("vendor_id")
  subject          String
  description      String
  evidenceUrl      String?       @map("evidence_url")
  status           DisputeStatus @default(open)
  resolutionNote   String?       @map("resolution_note")
  resolvedByUserId String?       @map("resolved_by_user_id")
  resolvedAt       DateTime?     @map("resolved_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime?     @updatedAt @map("updated_at")
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customer         User          @relation("DisputeCustomer", fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resolver         User?         @relation("DisputeResolver", fields: [resolvedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  messages         DisputeMessage[]

  @@index([orderId, status])
  @@index([vendorType, vendorId, status])
  @@map("dispute_cases")
}

model DisputeMessage {
  id            String    @id @default(uuid())
  disputeId     String    @map("dispute_id")
  senderUserId  String    @map("sender_user_id")
  senderRole    String    @map("sender_role")
  message       String
  attachmentUrl String?   @map("attachment_url")
  createdAt     DateTime  @default(now()) @map("created_at")
  dispute       DisputeCase @relation(fields: [disputeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sender        User      @relation(fields: [senderUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([disputeId, createdAt])
  @@map("dispute_messages")
}

model PayoutRequest {
  id                String      @id @default(uuid())
  vendorType        VendorType  @map("vendor_type")
  vendorId          String      @map("vendor_id")
  requesterUserId   String?     @map("requester_user_id")
  amount            Decimal     @db.Decimal(10, 2)
  currency          String      @default("JOD")
  status            PayoutStatus @default(requested)
  reason            String?
  reviewedByUserId  String?     @map("reviewed_by_user_id")
  reviewedAt        DateTime?   @map("reviewed_at")
  paidAt            DateTime?   @map("paid_at")
  transactionRef    String?     @map("transaction_ref")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime?   @updatedAt @map("updated_at")
  requester         User?       @relation("PayoutRequester", fields: [requesterUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviewer          User?       @relation("PayoutReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  transactions      FinancialTransaction[]

  @@index([vendorType, vendorId, status])
  @@index([status, createdAt])
  @@map("payout_requests")
}

model FinancialTransaction {
  id                String                    @id @default(uuid())
  orderId           String?                   @map("order_id")
  refundRequestId   String?                   @map("refund_request_id")
  payoutRequestId   String?                   @map("payout_request_id")
  transactionType   FinancialTransactionType  @map("transaction_type")
  status            String
  amount            Decimal                   @db.Decimal(10, 2)
  currency          String                    @default("JOD")
  provider          String?
