    "firebase-admin": "^13.6.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "next": "^14.1.0",
    "pdfkit": "^0.18.0",
    "pg": "^8.13.0",
    "pg-hstore": "^2.3.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sequelize": "^6.37.3",
    "stripe": "^22.0.0",
    "twilio": "^5.13.1",
    "nodemailer": "^6.10.1"
