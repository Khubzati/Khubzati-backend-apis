{
  "name": "khubzati-api",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node ./src/app.js",
    "start:kpi-worker": "node ./src/workers/kpi-worker.js",
    "start:kpi-worker:dev": "nodemon ./src/workers/kpi-worker.js --watch src",
    "lint": "next lint",
    "start:dev": "nodemon ./src/app.js --watch",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate deploy",
    "db:migrate:dev": "npx prisma migrate dev",
    "migrate:up": "npm run db:migrate",
    "migrate:undo": "echo \"Prisma migrations are forward-only in production. Use 'npx prisma migrate reset' in local development only.\" && exit 1",
    "db:legacy:sequelize:migrate": "npx sequelize-cli db:migrate",
    "db:legacy:sequelize:undo": "npx sequelize-cli db:migrate:undo",
    "create-admin": "node src/scripts/create-admin.js",
    "test": "NODE_ENV=test jest --runInBand --detectOpenHandles",
    "test:local": "DATABASE_URL=${TEST_DATABASE_URL:-postgresql://khubzati:khubzati@localhost:5544/khubzati_test?schema=public} DIRECT_URL=${TEST_DATABASE_URL:-postgresql://khubzati:khubzati@localhost:5544/khubzati_test?schema=public} NODE_ENV=test jest --runInBand --detectOpenHandles",
    "test:seed": "node scripts/test-setup.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
