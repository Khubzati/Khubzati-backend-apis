NODE_ENV=development
APP_PORT=3000
ENABLE_STUB_RESPONSES=false

# DB credentials
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_HOST=
DB_PORT=
DATABASE_URL=
DIRECT_URL=

# jwt info
JWT_SECRET=
JWT_SECRET_KEY=
JWT_EXPIRES_IN=
CORS_ORIGINS=http://localhost:3001,http://localhost:3004,http://127.0.0.1:3001,http://127.0.0.1:3004
APP_BASE_URL=http://localhost:3004
UPLOAD_STORAGE_DRIVER=local
UPLOAD_MAX_FILE_SIZE_BYTES=10485760
PAYMENT_MODE=sandbox
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3004/checkout/success
STRIPE_CANCEL_URL=http://localhost:3004/checkout/cancel
# Optional fallback when order currency is not enabled in your Stripe account.
# Keep FALSE in production unless you intentionally support currency conversion.
ENABLE_STRIPE_CURRENCY_FALLBACK=false
STRIPE_FALLBACK_CURRENCY=usd
# Optional conversion multiplier when fallback currency differs from order currency.
# Example (rough JOD->USD): 1.41
STRIPE_FALLBACK_RATE=1
DEFAULT_CURRENCY=JOD
ENABLE_NOON_PAYMENTS=false
ENABLE_RECURRING_ORDER_WORKER=true
ENABLE_KPI_WORKER=true
KPI_TIMEZONE=Asia/Amman
KPI_WORKER_INTERVAL_MS=60000
KPI_WORKER_LOCK_KEY=918273
SLA_ALERT_WEBHOOK_URL=
SLA_ALERT_WEBHOOK_SECRET=
SLA_ALERT_WEBHOOK_MAX_ATTEMPTS=6
SLA_ALERT_WEBHOOK_RETRY_BASE_SECONDS=30
SLA_QUEUE_LAG_SECONDS=300
SLA_STUCK_PAYOUT_COUNT=5
SLA_STUCK_PAYOUT_HOURS=24
SLA_AGING_DISPUTE_COUNT=5
SLA_AGING_DISPUTE_HOURS=48
SLA_HIGH_REFUND_RATIO=0.08
SLA_ASSIGNMENT_BREACH_COUNT=1
SLA_DEAD_LETTER_GROWTH_24H=20
REDIS_URL=

# Order Email (SMTP)
ENABLE_ORDER_EMAILS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Khubzati

# admin info
ADMIN_EMAIL=
ADMIN_PASSWORD=

# SMS Configuration (Twilio - Recommended)
# Get these from https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

TWILIO_PHONE_NUMBER=

# Firebase Admin SDK Configuration
# Choose ONE of the two methods below:

# Method 1: JSON File Path (RECOMMENDED for local development)
# Download service account JSON from Firebase Console and place it in your project
# Then set the path relative to project root or absolute path
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json

# Method 2: Environment Variables (For production/CI/CD)
# Extract values from service account JSON file
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# Supabase Configuration (Optional - for Next.js app features)
# Get these from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
